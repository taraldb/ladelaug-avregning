# Copy to .env (gitignored). Only secrets live here; everything else is config.yaml.
LADELAUG_SECRET_KEY=change-me-to-a-random-hex-string

# Zaptec Public API. Username + password are secrets; installation id is
# optional (also settable in config.yaml under zaptec:). probe_zaptec.py reads
# all three from here.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=
ZAPTEC_INSTALLATION_ID=
