# Copy to .env (gitignored). Only secrets live here; everything else is config.yaml.
LADELAUG_SECRET_KEY=change-me-to-a-random-hex-string

# Zaptec Public API. Username + password are secrets; installation id is
# optional (also settable in config.yaml under zaptec:). probe_zaptec.py reads
# all three from here.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=
ZAPTEC_INSTALLATION_ID=

# Gmail email backend (config.yaml: email.backend: gmail). Client id/secret come
# from a Google Cloud "Desktop app" OAuth client; mint the refresh token once
# with: uv run python scripts/gmail_oauth_bootstrap.py
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
